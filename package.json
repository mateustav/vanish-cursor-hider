{
  "name": "vanish-extension",
  "version": "1.0.0",
  "description": "Vanish: Automatically vanishes the mouse pointer during video playback on Disney+ and major streaming sites.",
  "main": "dist/background.js",
  "scripts": {
    "build": "esbuild src/background.ts src/content.ts src/popup/popup.ts src/options/options.ts --outdir=dist --bundle --target=es2020 --minify",
    "build:dev": "esbuild src/background.ts src/content.ts src/popup/popup.ts src/options/options.ts --outdir=dist --bundle --target=es2020",
    "watch": "esbuild src/background.ts src/content.ts src/popup/popup.ts src/options/options.ts --outdir=dist --bundle --target=es2020 --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vanish",
    "chrome-extension",
    "disneyplus",
    "cursor-hider",
    "pointer-hider",
    "fullscreen",
    "typescript"
  ],
  "author": "Mateus Tav",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "esbuild": "^0.20.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
